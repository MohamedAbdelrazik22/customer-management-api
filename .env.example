DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=customer_management
SERVER_PORT=8080

# Secret key used to sign JWT tokens — REQUIRED, application will not start without this
# Use a long, random string in production (minimum 32 characters recommended)
JWT_SECRET=your-super-secret-key-change-this

# Optional: number of seconds to wait for in-flight requests during graceful shutdown (default: 10)
# SHUTDOWN_TIMEOUT_SECONDS=10
